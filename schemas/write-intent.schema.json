{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReaderSignal replayable write intent",
  "description": "At most 3 MiB UTF-8 on disk. Record text and event text are additionally bounded to 1 MiB and 64 KiB UTF-8; runtime validates embedded identity and checksums.",
  "type": "object",
  "required": ["journal_version", "record_id", "record_text", "record_sha256", "event_text"],
  "properties": {
    "journal_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
    "record_text": {"type": "string", "maxLength": 1048576},
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_text": {"type": "string", "maxLength": 65536}
  },
  "additionalProperties": true
}
