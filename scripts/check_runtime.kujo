root := env_or("READERSIGNAL_TEST_TMP","")
if root == "" { eprint("runtime check requires isolated test scratch directory"); exit(1) }
try {
    guard := file_lock(root + "/runtime-probe.guard",0)
    file_unlock(guard)
    sync_directory_beneath(root,".")
    page := list_dir_page(root,"",1,".guard")
    if page["buffered_entries"] > 2 { eprint("native directory bound violated"); exit(1) }
    write_file_atomic_beneath(root,"probe/data","bounded",false)
    if read_file_beneath(root,"probe/data",7) != "bounded" { exit(1) }
    delete_file(root + "/runtime-probe.guard")
} except error {
    eprint("ReaderSignal requires POSIX Kujo 1.5.0 revision d501c2c46c51718ee10c4434f6cf9750bbd81453 or a compatible newer build: " + to_string(error))
    exit(1)
}
