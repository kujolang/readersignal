from src.common import get, has
export func record_type(command){return command};export func id_prefix(command){return command}
func required_text(payload,fields){for field in fields{value:=get(payload,field,"");if type(value)!="string"||trim(value)==""{return field+" must be non-empty text"};if len(value)>32768{return field+" exceeds 32 KiB"}};return ""}
func evidence_ids(value){if type(value)!="array"||len(value)==0||len(value)>1000{return false};for id in value{if type(id)!="string"||trim(id)==""||len(id)>128{return false}};return true}
export func validate_command(command,payload,artifact){if command=="snapshot"{e:=required_text(payload,["publication_receipt_id","window","measurement_status","attribution_limit"]);if e!=""{return e};metrics:=get(payload,"metrics",null);if type(metrics)!="dict"||len(keys(metrics))==0||len(keys(metrics))>256{return "metrics must be an object with 1..256 entries"};for key in keys(metrics){if len(key)>128||!has(["int","float"],type(metrics[key])){return "metric values must be numeric and keys bounded"}};return ""};if command=="feedback"{return required_text(payload,["publication_receipt_id","channel","summary","consent_basis"])};if has(["learn","followup"],command){e:=required_text(payload,["recommendation","attribution_limit"]);if e!=""{return e};if !evidence_ids(get(payload,"evidence_ids",null)){return "evidence_ids must contain 1..1000 bounded ids"}};return ""}
