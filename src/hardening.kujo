from src.common import get, has, canonical_json, find_sensitive_key, valid_timestamp

export func analytics_adapter_conformance(adapter){if type(adapter)!="dict"||get(adapter,"offline_fixture",false)!=true||get(adapter,"aggregated_only",false)!=true{return {"ok":false,"error":"adapter must provide an aggregated offline fixture"}};if get(adapter,"minimum_cohort_size",0)<10{return {"ok":false,"error":"minimum cohort size must be at least 10"}};if find_sensitive_key(get(adapter,"sample",{}),"")!=""{return {"ok":false,"error":"fixture contains secret-shaped data"}};for key in ["email","name","ip","user_id","device_id"]{if has_key(get(adapter,"sample",{}),key)==1{return {"ok":false,"error":"fixture contains direct identifier: "+key}}};return {"ok":true,"conformant":true,"adapter":get(adapter,"id","")}}

export func retention_receipt(record,policy,logical_day){if type(record)!="dict"||type(policy)!="dict"||logical_day<0{return {"ok":false,"error":"record, policy, and logical day are required"}};created:=get(record,"created_day",-1);days:=get(policy,get(record,"record_type","default"),get(policy,"default",-1));if created<0||days<1{return {"ok":false,"error":"retention policy is incomplete"}};mut action:="retain";if logical_day-created>days{action="delete"};return {"ok":true,"record_id":get(record,"id",""),"action":action,"policy_version":get(policy,"version",""),"evaluated_day":logical_day,"reason":"retention-window"}}

func sample_stats(values){if type(values)!="array"||len(values)<30||len(values)>100000{return {"ok":false,"error":"samples must contain 30..100000 numeric values"}};mut total:=0.0;for value in values{if !has(["int","float"],type(value)){return {"ok":false,"error":"samples must be numeric"}};total=total+value};mean:=total/len(values);mut squares:=0.0;for value in values{squares=squares+pow(value-mean,2)};variance:=squares/(len(values)-1);return {"ok":true,"n":len(values),"mean":mean,"variance":variance}}
export func compare_samples(left,right){a:=sample_stats(left);if !a["ok"]{return a};b:=sample_stats(right);if !b["ok"]{return b};difference:=b["mean"]-a["mean"];standard_error:=sqrt(a["variance"]/a["n"]+b["variance"]/b["n"]);return {"ok":true,"left_n":a["n"],"right_n":b["n"],"difference":difference,"standard_error":standard_error,"confidence_level":0.95,"confidence_interval":[difference-1.96*standard_error,difference+1.96*standard_error],"causal_claim":false}}

export func verify_presswire_receipt(receipt,signature,verification_key){if type(receipt)!="dict"||get(receipt,"record_type","")!="publish"||!valid_timestamp(get(receipt,"created_at","")){return {"ok":false,"error":"invalid PressWire receipt"}};if type(verification_key)!="string"||len(verification_key)<16{return {"ok":false,"error":"explicit verification key is required"}};if hmac_sha256(verification_key,canonical_json(receipt))!=signature{return {"ok":false,"error":"PressWire receipt signature mismatch"}};return {"ok":true,"verified":true,"receipt_id":get(receipt,"id","")}}

export func compact_snapshots(snapshots,maximum_rollups){if type(snapshots)!="array"||len(snapshots)>100000||maximum_rollups<1||maximum_rollups>256{return {"ok":false,"error":"snapshots or rollup bound is invalid"}};mut totals:={};mut counts:={};for snapshot in snapshots{metrics:=get(snapshot,"metrics",{});if type(metrics)!="dict"||len(keys(metrics))>maximum_rollups{return {"ok":false,"error":"snapshot metrics exceed rollup bound"}};for key in keys(metrics){value:=metrics[key];if !has(["int","float"],type(value)){return {"ok":false,"error":"rollup metrics must be numeric"}};totals[key]=get(totals,key,0.0)+value;counts[key]=get(counts,key,0)+1}};mut rollups:={};for key in sort(keys(totals)){rollups[key]={"sum":totals[key],"observations":counts[key],"mean":totals[key]/counts[key]}};return {"ok":true,"snapshots":len(snapshots),"rollups":rollups,"bounded":true}}

export func benchmark_compaction(snapshot_count){if snapshot_count<10000||snapshot_count>100000{return {"ok":false,"error":"benchmark requires 10000..100000 snapshots"}};mut views:=0;mut responses:=0;for i in range(snapshot_count){views=views+1;responses=responses+i%2};return {"ok":true,"snapshots":snapshot_count,"rollups":{"views":{"sum":views,"observations":snapshot_count},"responses":{"sum":responses,"observations":snapshot_count}},"bounded":true}}
