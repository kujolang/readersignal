from src.common import get, has, canonical_json, find_sensitive_key, valid_timestamp

func private_identifier(value) {
    if type(value) == "dict" {
        for key in keys(value) {
            normalized := lower(replace_str(replace_str(key, "-", "_"), " ", "_"))
            if has(["email","name","ip","user_id","device_id"], normalized) { return true }
            if private_identifier(value[key]) { return true }
        }
    }
    if type(value) == "array" { for item in value { if private_identifier(item) { return true } } }
    return false
}

export func analytics_adapter_conformance(adapter) {
    if type(adapter) != "dict" || get(adapter,"offline_fixture",false) != true || get(adapter,"aggregated_only",false) != true { return {"ok":false,"error":"adapter must provide an aggregated offline fixture"} }
    cohort := get(adapter,"minimum_cohort_size",0); sample := get(adapter,"sample",null)
    if type(cohort) != "int" || cohort < 10 { return {"ok":false,"error":"minimum cohort size must be an integer of at least 10"} }
    if type(sample) != "dict" { return {"ok":false,"error":"sample must be an aggregate object"} }
    if has_key(sample,"cohort_size") == 1 && (type(sample["cohort_size"]) != "int" || sample["cohort_size"] < cohort) { return {"ok":false,"error":"sample cohort is below the declared minimum"} }
    if find_sensitive_key(sample,"") != "" || private_identifier(sample) { return {"ok":false,"error":"fixture contains private identifier or secret-shaped data"} }
    return {"ok":true,"conformant":true,"adapter":get(adapter,"id","")}
}

export func retention_receipt(record,policy,logical_day){if type(record)!="dict"||type(policy)!="dict"||type(logical_day)!="int"||logical_day<0{return {"ok":false,"error":"record, policy, and logical day are required"}};created:=get(record,"created_day",-1);days:=get(policy,get(record,"record_type","default"),get(policy,"default",-1));if type(created)!="int"||type(days)!="int"||created<0||days<1{return {"ok":false,"error":"retention policy is incomplete"}};mut action:="retain";if logical_day-created>days{action="delete"};return {"ok":true,"record_id":get(record,"id",""),"action":action,"policy_version":get(policy,"version",""),"evaluated_day":logical_day,"reason":"retention-window"}}

func sample_stats(values){if type(values)!="array"||len(values)<30||len(values)>100000{return {"ok":false,"error":"samples must contain 30..100000 numeric values"}};mut total:=0.0;for value in values{if (type(value)!="int"&&type(value)!="float") || value-value!=0{return {"ok":false,"error":"samples must be finite numeric values"}};total=total+value;if total-total!=0{return {"ok":false,"error":"sample sum overflow"}}};mean:=total/len(values);mut squares:=0.0;for value in values{squares=squares+pow(value-mean,2)};if squares-squares!=0{return {"ok":false,"error":"sample variance overflow"}};variance:=squares/(len(values)-1);return {"ok":true,"n":len(values),"mean":mean,"variance":variance}}
export func compare_samples(left,right){a:=sample_stats(left);if !a["ok"]{return a};b:=sample_stats(right);if !b["ok"]{return b};difference:=b["mean"]-a["mean"];standard_error:=sqrt(a["variance"]/a["n"]+b["variance"]/b["n"]);return {"ok":true,"left_n":a["n"],"right_n":b["n"],"difference":difference,"standard_error":standard_error,"confidence_level":0.95,"confidence_interval":[difference-1.96*standard_error,difference+1.96*standard_error],"causal_claim":false}}

export func verify_presswire_receipt(receipt,signature,verification_key){if type(receipt)!="dict"||get(receipt,"record_type","")!="publish"||!valid_timestamp(get(receipt,"created_at","")){return {"ok":false,"error":"invalid PressWire receipt"}};if type(verification_key)!="string"||len(verification_key)<16{return {"ok":false,"error":"explicit verification key is required"}};if hmac_sha256(verification_key,canonical_json(receipt))!=signature{return {"ok":false,"error":"PressWire receipt signature mismatch"}};return {"ok":true,"verified":true,"receipt_id":get(receipt,"id","")}}

export func compact_snapshots(snapshots, maximum_rollups) {
    if type(snapshots) != "array" || len(snapshots) > 100000 || type(maximum_rollups) != "int" || maximum_rollups < 1 || maximum_rollups > 256 { return {"ok":false,"error":"snapshots or rollup bound is invalid"} }
    mut totals := {}; mut counts := {}; mut distinct := 0
    for snapshot in snapshots {
        if type(snapshot) != "dict" { return {"ok":false,"error":"snapshot must be an object"} }
        metrics := {}; if has_key(snapshot,"metrics") == 1 { metrics = snapshot["metrics"] }
        if type(metrics) != "dict" { return {"ok":false,"error":"snapshot metrics must be an object"} }
        metric_keys := keys(metrics)
        if len(metric_keys) > maximum_rollups { return {"ok":false,"error":"snapshot metrics exceed rollup bound"} }
        for key in metric_keys {
            value := metrics[key]
            if len(key) > 128 || (type(value) != "int" && type(value) != "float") { return {"ok":false,"error":"rollup metrics must be numeric with bounded keys"} }
            if has_key(totals,key) == 0 {
                if distinct >= maximum_rollups { return {"ok":false,"error":"aggregate metrics exceed rollup bound"} }
                distinct = distinct + 1
                totals[key] = 0.0; counts[key] = 0
            }
            totals[key] = totals[key] + value
            if totals[key] - totals[key] != 0 { return {"ok":false,"error":"rollup sum must be finite"} }
            counts[key] = counts[key] + 1
        }
    }
    mut rollups := {}
    for key in sort(keys(totals)) { rollups[key] = {"sum":totals[key],"observations":counts[key],"mean":totals[key]/counts[key]} }
    return {"ok":true,"snapshots":len(snapshots),"rollups":rollups,"bounded":true}
}

export func benchmark_compaction(snapshot_count) {
    if type(snapshot_count) != "int" || snapshot_count < 10000 || snapshot_count > 100000 { return {"ok":false,"error":"benchmark requires 10000..100000 snapshots"} }
    // Parse a bounded fixture once: repeatedly extending a persistent array copies it.
    pair := "{\"metrics\":{\"views\":1,\"responses\":0}},{\"metrics\":{\"views\":1,\"responses\":1}},"
    body := repeat(pair, to_int(snapshot_count / 2))
    fixture := "[" + substring(body, 0, len(body) - 1) + "]"
    snapshots := parse_json(fixture)
    if snapshot_count % 2 == 1 { snapshots = push(snapshots,{"metrics":{"views":1,"responses":0}}) }
    result := compact_snapshots(snapshots, 16)
    return result
}
