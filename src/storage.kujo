from src.common import get, parse_object, safe_id, utf8_size, valid_timestamp

func ensure_tree(path) {
    if path == "" || path == "." { return "" }
    parts := split(path, "/"); mut current := ""; if starts_with(path, "/") { current = "/" }
    for part in parts {
        if part != "" && part != "." {
            if part == ".." { return "path traversal is not allowed" }
            if current == "/" { current = "/" + part } else if current == "" { current = part } else { current = current + "/" + part }
            if file_exists(current) {
                if !path_is_dir(current) { return "path component is not a directory: " + current }
            } else { try { create_dir(current) } except error { return "could not create directory: " + current } }
            parent := dirname(current); if parent == "" { parent = "." }
            try { sync_directory_beneath(parent,".") } except error { return "directory durability unconfirmed: " + current }
        }
    }
    return ""
}

export func validate_state_path(path) {
    if type(path) != "string" || trim(path) == "" { return "state path is empty or invalid" }
    for part in split(replace_str(path, "\\", "/"), "/") { if part == ".." { return "state path traversal is not allowed" } }
    if file_exists(path) && path_is_symlink(path) { return "state directory symlinks are not allowed" }
    if file_exists(path) && !path_is_dir(path) { return "state path is not a directory" }
    return ""
}

export func records_dir(state) { return join_path(state, "records") }
export func history_dir(state) { return join_path(state, "history") }
func guards_dir(state) { return join_path(state, "guards") }
func locks_dir(state) { return join_path(state, "locks") }
export func record_path(state, id) { return join_path(records_dir(state), id + ".json") }

func prepare_state(state, metadata, create) {
    error := validate_state_path(state); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    if create { error = ensure_tree(state); if error != "" { return storage_error("unsafe_state",error) } }
    for dir in [records_dir(state), history_dir(state), locks_dir(state), guards_dir(state)] {
        if !create && !occupied(dir) { continue }
        if create && !occupied(dir) {
            try { create_dir(dir) } except error { return storage_error("unsafe_state","could not create managed directory") }
        }
        if path_is_symlink(dir) || !path_is_dir(dir) { return storage_error("unsafe_state","managed state paths must be regular directories") }
    }
    path := join_path(state, "metadata.json")
    if file_exists(path) {
        if path_is_symlink(path) || !path_is_file(path) { return {"ok": false, "code": "unsafe_state", "error": "metadata must be a regular non-symlink file"} }
        if file_size(path) > 65536 { return {"ok": false, "code": "metadata_too_large", "error": "metadata exceeds 64 KiB"} }
        parsed := parse_object(read_file_beneath(state,"metadata.json",65536), "state metadata"); if !parsed["ok"] { return parsed }
        existing := parsed["value"]
        if get(existing, "tool", "") != get(metadata, "tool", "") || get(existing, "contract_version", "") != get(metadata, "contract_version", "") { return {"ok": false, "code": "incompatible_state", "error": "state metadata belongs to an incompatible tool or contract"} }
    } else if create {
        try { write_file_atomic_beneath(state,"metadata.json", to_json_pretty(metadata) + "\n", false) } except error {
            if path_is_file(path) {
                winner := prepare_state(state,metadata,false); if !winner["ok"] { return winner }
            } else { return {"ok": false, "code": "write_failed", "error": "atomic metadata creation failed"} }
        }
    }
    if create { sync_directory_beneath(state,".") }
    return {"ok": true, "value": {"state": state, "initialized": true}}
}

export func initialize(state, metadata) { return prepare_state(state, metadata, true) }
export func inspect_state(state, metadata) { return prepare_state(state, metadata, false) }

func lock_path(state, id) { return join_path(locks_dir(state), id + ".lock") }

func occupied(path) {
    if file_exists(path) { return true }
    try { return path_is_symlink(path) } except error { return false }
}

func intent_exists(state,id) { return occupied(lock_path(state,id)) }

func storage_error(code, error) { return {"ok":false,"code":code,"error":error} }

func sync_phase(state,directory,phase) {
    try { sync_directory_beneath(state,directory); return {"ok":true} }
    except error {
        return {"ok":false,"code":"durability_unconfirmed","error":"directory sync failed; preserve evidence and retry recovery: " + to_string(error),"value":{"phase":phase,"durability_confirmed":false,"intent_cleared":phase == "cleanup"}}
    }
}

func check_write_state(state) {
    error := validate_state_path(state)
    if error != "" { return storage_error("unsafe_state",error) }
    for dir in [records_dir(state), history_dir(state), locks_dir(state), guards_dir(state)] {
        if !path_is_dir(dir) || path_is_symlink(dir) { return storage_error("unsafe_state","initialize regular managed directories before writing") }
    }
    return {"ok":true}
}

func acquire_guard(state, id) {
    try { return {"ok":true,"handle":file_lock(join_path(guards_dir(state),id + ".guard"),0)} }
    except error { return storage_error("write_conflict","record guard is busy or unsafe: " + id) }
}

func event_path_for(state, record) {
    return join_path(history_dir(state), substring(sha256(record["created_at"] + "\n" + record["id"]),0,32) + ".json")
}

// The intent occupies the legacy lock pathname, so older no-clobber writers
// also refuse it. Persistent OS guard files must never be unlinked.
export func begin_write(state, record) {
    id := get(record,"id","")
    if !safe_id(id) { return storage_error("unsafe_id","unsafe record id") }
    checked := check_write_state(state); if !checked["ok"] { return checked }
    serialized := to_json_pretty(record) + "\n"
    if utf8_size(serialized) > 1048576 { return storage_error("record_too_large","serialized record exceeds 1 MiB") }
    checksum := sha256(serialized)
    event := {"schema_version":"1.0.0","event":"record.created","record_id":id,"actor":record["actor"],"at":record["created_at"],"record_sha256":checksum}
    return begin_evidence(state,id,serialized,to_json_pretty(event) + "\n",checksum)
}

func begin_evidence(state,id,serialized,event_text,checksum) {
    journal := {"journal_version":"1.0.0","record_id":id,"record_text":serialized,"record_sha256":checksum,"event_text":event_text}
    record := parse_json(serialized)
    guard := acquire_guard(state,id); if !guard["ok"] { return guard }
    mut result := {}
    try {
        if intent_exists(state,id) { result = storage_error("recovery_required","pending or legacy intent exists; inspect with recover --id " + id) }
        else if file_exists(record_path(state,id)) { result = storage_error("duplicate_id","record already exists: " + id) }
        else if file_exists(event_path_for(state,record)) { result = storage_error("history_conflict","audit history event already exists") }
        else {
            write_file_atomic_beneath(state,"locks/" + id + ".lock",to_json(journal) + "\n",false)
            result = sync_phase(state,"locks","intent")
            if result["ok"] { result = {"ok":true,"handle":guard["handle"],"id":id,"checksum":checksum} }
        }
    } except error { result = storage_error("write_failed","could not persist write intent: " + to_string(error)) }
    if !result["ok"] { file_unlock(guard["handle"]) }
    return result
}

func load_intent(state, id) {
    path := lock_path(state,id)
    if !path_is_file(path) || path_is_symlink(path) { return storage_error("recovery_unavailable","no regular journal; legacy locks require offline review") }
    if file_size(path) > 3145728 { return storage_error("journal_too_large","journal exceeds 3 MiB") }
    return validate_intent(state,id,read_file_beneath(state,"locks/" + id + ".lock",3145728))
}

func validate_intent(state,id,text) {
    if utf8_size(text) > 3145728 { return storage_error("journal_too_large","journal exceeds 3 MiB") }
    parsed := parse_object(text,"write intent")
    if !parsed["ok"] { return storage_error("invalid_journal","legacy or malformed intent; no files changed") }
    journal := parsed["value"]
    if get(journal,"journal_version","") != "1.0.0" || get(journal,"record_id","") != id || type(get(journal,"record_text",null)) != "string" || type(get(journal,"event_text",null)) != "string" { return storage_error("invalid_journal","incompatible journal identity or shape") }
    text := journal["record_text"]; event_text := journal["event_text"]
    if utf8_size(text) > 1048576 || utf8_size(event_text) > 65536 || sha256(text) != get(journal,"record_sha256","") { return storage_error("invalid_journal","journal byte limit or checksum mismatch") }
    record_result := parse_object(text,"journal record"); event_result := parse_object(event_text,"journal event")
    if !record_result["ok"] || !event_result["ok"] { return storage_error("invalid_journal","invalid journal record or event") }
    record := record_result["value"]; event := event_result["value"]
    if get(record,"id","") != id || !valid_timestamp(get(record,"created_at",null)) || type(get(record,"actor",null)) != "string" { return storage_error("invalid_journal","invalid journal record identity") }
    if get(event,"schema_version","") != "1.0.0" || get(event,"event","") != "record.created" || get(event,"record_id","") != id || get(event,"actor",null) != record["actor"] || get(event,"at",null) != record["created_at"] || get(event,"record_sha256",null) != journal["record_sha256"] { return storage_error("invalid_journal","journal event does not match record") }
    return {"ok":true,"journal":journal,"record_path":record_path(state,id),"event_path":event_path_for(state,record)}
}

func check_target(state, relative, expected, maximum) {
    path := join_path(state,relative)
    // symlink inspection must also reject dangling links, for which file_exists
    // follows the target and returns false.
    mut link := false
    try { link = path_is_symlink(path) } except error { link = false }
    if link { return storage_error("recovery_conflict","recovery target is a symlink") }
    if !file_exists(path) { return {"ok":true,"missing":true} }
    if !path_is_file(path) || file_size(path) > maximum { return storage_error("recovery_conflict","recovery target is not a bounded regular file") }
    if read_file_beneath(state,relative,maximum) != expected { return storage_error("recovery_conflict","existing evidence differs from journal; no files changed") }
    return {"ok":true,"missing":false}
}

func commit_intent(state, id, dry_run, recovery_actor) {
    intent := load_intent(state,id); if !intent["ok"] { return intent }
    journal := intent["journal"]
    record := check_target(state,"records/" + id + ".json",journal["record_text"],1048576)
    event := check_target(state,"history/" + basename(intent["event_path"]),journal["event_text"],65536)
    if !record["ok"] { return record }; if !event["ok"] { return event }
    receipt_path := ""; receipt_missing := false
    if recovery_actor != "" {
        receipt_path = join_path(history_dir(state),"recovered-" + substring(sha256(id + "\n" + journal["record_sha256"]),0,32) + ".json")
        if file_exists(receipt_path) {
            if !path_is_file(receipt_path) || path_is_symlink(receipt_path) || file_size(receipt_path) > 65536 { return storage_error("recovery_conflict","unsafe existing recovery receipt") }
            parsed := parse_object(read_file_beneath(state,"history/" + basename(receipt_path),65536),"recovery receipt")
            if !parsed["ok"] { return storage_error("recovery_conflict","invalid recovery receipt; intent retained") }
            receipt := parsed["value"]
            if get(receipt,"schema_version","") != "1.0.0" || get(receipt,"event","") != "record.recovered" || get(receipt,"record_id","") != id || get(receipt,"record_sha256","") != journal["record_sha256"] || type(get(receipt,"actor",null)) != "string" || trim(receipt["actor"]) == "" || !valid_timestamp(get(receipt,"at",null)) { return storage_error("recovery_conflict","recovery receipt differs; no files changed") }
        } else {
            // A dangling link is an existing unsafe target, never a free slot.
            mut link := false; try { link = path_is_symlink(receipt_path) } except error { link = false }
            if link { return storage_error("recovery_conflict","recovery receipt is a symlink") }
            receipt_missing = true
        }
    }
    if dry_run { return {"ok":true,"value":{"id":id,"dry_run":true,"record_missing":record["missing"],"event_missing":event["missing"]}} }
    confirmed := sync_phase(state,"locks","intent"); if !confirmed["ok"] { return confirmed }
    if record["missing"] { write_file_atomic_beneath(state,"records/" + id + ".json",journal["record_text"],false) }
    confirmed = sync_phase(state,"records","record"); if !confirmed["ok"] { return confirmed }
    if event["missing"] { write_file_atomic_beneath(state,"history/" + basename(intent["event_path"]),journal["event_text"],false) }
    if receipt_missing { write_file_atomic_beneath(state,"history/" + basename(receipt_path),to_json({"schema_version":"1.0.0","event":"record.recovered","record_id":id,"record_sha256":journal["record_sha256"],"actor":recovery_actor,"at":now_utc()}) + "\n",false) }
    confirmed = sync_phase(state,"history","history"); if !confirmed["ok"] { return confirmed }
    delete_file(lock_path(state,id))
    confirmed = sync_phase(state,"locks","cleanup"); if !confirmed["ok"] { return confirmed }
    return {"ok":true,"value":{"durability_confirmed":true,"path":intent["record_path"],"checksum":journal["record_sha256"],"id":id,"recovered":recovery_actor != ""}}
}

export func finish_write(state, transaction) {
    mut result := {}
    try { result = commit_intent(state,transaction["id"],false,"") }
    except error { result = storage_error("write_failed","publication durability unconfirmed; inspect and retry recovery (intent may be cleared): " + to_string(error)) }
    file_unlock(transaction["handle"])
    return result
}

export func save_new(state, record) {
    transaction := begin_write(state,record); if !transaction["ok"] { return transaction }
    return finish_write(state,transaction)
}

export func recover_record(state, id, actor, dry_run) {
    if !safe_id(id) { return storage_error("unsafe_id","recover requires a safe --id") }
    if type(actor) != "string" || trim(actor) == "" || len(actor) > 256 || !regex_match(actor,"^[^\\x00-\\x1F\\x7F]+$") { return storage_error("actor_required","recover requires a bounded printable --actor") }
    checked := check_write_state(state); if !checked["ok"] { return checked }
    if dry_run && !file_exists(join_path(guards_dir(state),id + ".guard")) { return storage_error("recovery_unavailable","no existing guard for a read-only recovery preview") }
    if !dry_run { error := ensure_tree(state); if error != "" { return storage_error("durability_unconfirmed",error) }; sync_directory_beneath(state,".") }
    guard := acquire_guard(state,id); if !guard["ok"] { return guard }
    mut result := {}
    try {
        if !intent_exists(state,id) {
            loaded := load_record(state,id)
            if !loaded["ok"] { result = loaded }
            else {
                result = verify_record_history(state,loaded["value"],loaded["checksum"])
                if result["ok"] {
                    if !dry_run { for dir in ["records","history","locks"] { sync_directory_beneath(state,dir) } }
                    result = {"ok":true,"value":{"id":id,"recovered":false,"dry_run":dry_run,"already_complete":true,"durability_confirmed":!dry_run}} }
            }
        } else { result = commit_intent(state,id,dry_run,actor) }
    } except error { result = storage_error("recovery_failed","recovery durability unconfirmed; inspect and retry (intent may be cleared): " + to_string(error)) }
    file_unlock(guard["handle"])
    return result
}

// An observation, never authority to remove a lock or synthesize an event.
// Unlike recover --dry-run, this works on legacy state without creating guards.
export func recovery_status(state, id) {
    if !safe_id(id) { return storage_error("unsafe_id","recovery-status requires a safe --id") }
    error := validate_state_path(state); if error != "" { return storage_error("unsafe_state",error) }
    for dir in [records_dir(state),history_dir(state),locks_dir(state),guards_dir(state)] {
        mut link := false; try { link = path_is_symlink(dir) } except error { link = false }
        if link || (file_exists(dir) && !path_is_dir(dir)) { return storage_error("unsafe_state","managed paths must be regular directories") }
    }
    mut status := "absent"; mut issue := ""; mut record_ok := false; mut history_ok := false
    mut journal_ok := false
    loaded := load_record(state,id)
    if loaded["ok"] {
        record_ok = true
        try {
            verified := verify_record_history(state,loaded["value"],loaded["checksum"])
            history_ok = verified["ok"]
            if !history_ok { issue = verified["code"] }
        } except error { issue = "invalid_record_identity" }
        if history_ok { status = "complete" } else { status = "evidence_required" }
    } else if loaded["code"] != "not_found" { status = "evidence_required"; issue = loaded["code"] }
    mut record_link := false; try { record_link = path_is_symlink(record_path(state,id)) } except error { record_link = false }
    if record_link || (file_exists(record_path(state,id)) && !path_is_file(record_path(state,id))) { status = "evidence_required"; issue = "unsafe_record" }
    if intent_exists(state,id) {
        status = "legacy_or_invalid_intent"
        try {
            preview := commit_intent(state,id,true,"status-inspection")
            if preview["ok"] { journal_ok = true; status = "replayable"; issue = "" }
            else {
                issue = preview["code"]
                if issue == "recovery_conflict" { journal_ok = true; status = "conflicting_evidence" }
            }
        } except error { issue = "intent_read_failed" }
    }
    return {"ok":true,"value":{"id":id,"status":status,"issue":issue,"journal_valid":journal_ok,"record_readable":record_ok,"history_valid":history_ok,"observation_only":true}}
}

func read_record(state, id, checksum) {
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    path := record_path(state, id)
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "not_found", "error": "record not found: " + id} }
    size := file_size(path)
    if size > 1048576 { return {"ok": false, "code": "record_too_large", "error": "record exceeds 1 MiB"} }
    mut contents := ""
    try { contents = read_file_beneath(state,"records/" + id + ".json",1048576) }
    except error { return storage_error("record_read_failed","bounded record read failed: " + id) }
    size = utf8_size(contents)
    mut record := null
    try { record = parse_json(contents) } except error { return {"ok":false,"code":"malformed_json","error":"record " + id + " is not valid JSON"} }
    if type(record) != "dict" { return {"ok":false,"code":"invalid_shape","error":"record " + id + " must be a JSON object"} }
    if has_key(record,"id") == 0 || record["id"] != id { return {"ok": false, "code": "id_mismatch", "error": "record id does not match filename"} }
    if checksum { checksum = sha256(contents) } else { checksum = null }
    return {"ok": true, "value": record, "checksum": checksum, "bytes": size}
}

export func load_record(state, id) {
    state_error := validate_state_path(state); if state_error != "" { return {"ok": false, "code": "unsafe_state", "error": state_error} }
    dir := records_dir(state); if file_exists(dir) && (path_is_symlink(dir) || !path_is_dir(dir)) { return {"ok": false, "code": "unsafe_state", "error": "records path must be a regular directory"} }
    result := read_record(state, id, true)
    if !result["ok"] { return result }
    return {"ok": true, "value": result["value"], "checksum": result["checksum"]}
}

export func list_records(state, kind, after, limit) {
    mut records := []; mut warnings := []; mut truncated := false; mut scanned := 0; mut bytes := 0; mut cursor := after
    state_error := validate_state_path(state); if state_error != "" { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": state_error}], "truncated": false} }
    dir := records_dir(state); if file_exists(dir) && (path_is_symlink(dir) || !path_is_dir(dir)) { return {"records": records, "warnings": [{"id": "", "code": "unsafe_state", "error": "records path must be a regular directory"}], "truncated": false} }; if !path_is_dir(dir) { return {"records": records, "warnings": warnings, "truncated": false} }
    filename_after := ""; if after != "" { filename_after = after + ".json" }
    page := list_dir_page(dir,filename_after,1000,".json")
    truncated = page["truncated"]
    for name in page["entries"] {
        id := substring(name,0,len(name) - 5)
        loaded := read_record(state,id,false)
        scanned = scanned + 1
        if loaded["ok"] {
            record := loaded["value"]
            if kind == "" || get(record,"record_type","") == kind {
                if len(records) >= limit || bytes + loaded["bytes"] > 4194304 { truncated = true; break }
                records = push(records,record); bytes = bytes + loaded["bytes"]
            }
        } else { warnings = push(warnings,{"id":id,"code":loaded["code"],"error":loaded["error"]}) }
        cursor = id
    }
    return {"records": records, "warnings": warnings, "truncated": truncated, "next_cursor": cursor, "scanned": scanned, "directory_entries_examined":page["examined_entries"], "directory_entries_buffered":page["buffered_entries"]}
}

export func verify_record_history(state, record, checksum) {
    dir := history_dir(state)
    if !path_is_dir(dir) || path_is_symlink(dir) { return {"ok":false,"code":"unsafe_history","error":"history must be a regular directory"} }
    path := join_path(dir, substring(sha256(record["created_at"] + "\n" + record["id"]), 0, 32) + ".json")
    if !path_is_file(path) || path_is_symlink(path) { return {"ok":false,"code":"history_missing","error":"record audit event is missing or unsafe"} }
    if file_size(path) > 65536 { return {"ok":false,"code":"history_too_large","error":"audit event exceeds 64 KiB"} }
    parsed := parse_object(read_file_beneath(state,"history/" + basename(path),65536), "audit event"); if !parsed["ok"] { return parsed }; event := parsed["value"]
    if get(event,"schema_version","") != "1.0.0" || get(event,"event","") != "record.created" || get(event,"record_id","") != record["id"] || get(event,"actor","") != record["actor"] || get(event,"at","") != record["created_at"] || get(event,"record_sha256","") != checksum { return {"ok":false,"code":"history_mismatch","error":"record does not match its audit event"} }
    return {"ok":true}
}

// A checkpoint contains original evidence, never a synthesized creation event.
export func backup_record(state,id) {
    loaded := load_record(state,id); if !loaded["ok"] { return loaded }
    if intent_exists(state,id) { return storage_error("recovery_required","finish pending recovery before backing up this record") }
    verified := verify_record_history(state,loaded["value"],loaded["checksum"]); if !verified["ok"] { return verified }
    record_text := read_file_beneath(state,"records/" + id + ".json",1048576)
    event_text := read_file_beneath(state,"history/" + basename(event_path_for(state,loaded["value"])),65536)
    evidence := {"backup_version":"1.0.0","journal_version":"1.0.0","record_id":id,"record_text":record_text,"record_sha256":loaded["checksum"],"event_text":event_text}
    checked := validate_intent(state,id,to_json(evidence)); if !checked["ok"] { return checked }
    return {"ok":true,"value":evidence}
}

export func restore_record(state,id,evidence,actor,dry_run,metadata) {
    if !safe_id(id) { return storage_error("unsafe_id","restore requires a safe --id") }
    if type(actor) != "string" || trim(actor) == "" || len(actor) > 256 || !regex_match(actor,"^[^\\x00-\\x1F\\x7F]+$") { return storage_error("actor_required","restore requires a bounded printable --actor") }
    if type(evidence) != "dict" || get(evidence,"backup_version","") != "1.0.0" { return storage_error("invalid_backup","unsupported backup format") }
    checked := validate_intent(state,id,to_json(evidence)); if !checked["ok"] { return checked }
    checked = inspect_state(state,metadata); if !checked["ok"] { return checked }
    if intent_exists(state,id) || occupied(record_path(state,id)) || occupied(event_path_for(state,parse_json(evidence["record_text"]))) { return storage_error("restore_conflict","restore requires an unused ID; restore into a separate state and preserve damaged evidence") }
    if dry_run { return {"ok":true,"value":{"id":id,"dry_run":true,"checksum":evidence["record_sha256"]}} }
    checked = initialize(state,metadata); if !checked["ok"] { return checked }
    transaction := begin_evidence(state,id,evidence["record_text"],evidence["event_text"],evidence["record_sha256"])
    if !transaction["ok"] { return transaction }
    mut result := {}
    try { result = commit_intent(state,id,false,actor) }
    except error { result = storage_error("restore_uncertain","restore interrupted; inspect and recover the target ID: " + to_string(error)) }
    file_unlock(transaction["handle"])
    return result
}
