runtime := args()[0]; mut passed := 0; mut failed := 0
func check(ok,label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
version := spawn_process([runtime,"run","readersignal.kujo","--","--version","--json"],{"timeout_ms":5000,"max_output_bytes":4096})
check(version.exitcode == 0 && parse_json(version.stdout)["ok"], "version alias JSON envelope")
missing := spawn_process([runtime,"run","readersignal.kujo","--","snapshot","--actor"],{"timeout_ms":5000,"max_output_bytes":4096})
check(missing.exitcode == 2, "missing value usage exit")
unknown := spawn_process([runtime,"run","readersignal.kujo","--","--version","--unknown"],{"timeout_ms":5000,"max_output_bytes":4096})
check(unknown.exitcode == 2, "version flags validated")
base := env_or("READERSIGNAL_TEST_TMP","/tmp") + "/backup-cli-" + uuid_v4(); create_dir(base)
created := spawn_process([runtime,"run","readersignal.kujo","--","snapshot","--state",base + "/source","--id","snapshot-cli","--input","fixtures/core.json","--actor","writer","--json"],{"timeout_ms":10000,"max_output_bytes":8192})
check(created.exitcode == 0 && parse_json(created.stdout)["data"]["storage"]["durability_confirmed"],"CLI create confirms durability")
backed := spawn_process([runtime,"run","readersignal.kujo","--","backup","--state",base + "/source","--id","snapshot-cli","--output",base + "/checkpoint.json","--json"],{"timeout_ms":10000,"max_output_bytes":4096})
check(backed.exitcode == 0 && parse_json(backed.stdout)["data"]["durability_confirmed"],"CLI backup publishes durable checkpoint")
restored := spawn_process([runtime,"run","readersignal.kujo","--","restore","--state",base + "/target","--id","snapshot-cli","--input",base + "/checkpoint.json","--actor","restorer","--json"],{"timeout_ms":10000,"max_output_bytes":4096})
check(restored.exitcode == 0 && parse_json(restored.stdout)["data"]["durability_confirmed"],"CLI restore envelope confirms durability")
validated := spawn_process([runtime,"run","readersignal.kujo","--","validate","--state",base + "/target","--id","snapshot-cli","--json"],{"timeout_ms":10000,"max_output_bytes":4096})
check(validated.exitcode == 0 && parse_json(validated.stdout)["ok"],"CLI restored evidence validates")
refused := spawn_process([runtime,"run","readersignal.kujo","--","restore","--state",base + "/target","--id","snapshot-cli","--input",base + "/checkpoint.json","--actor","restorer","--json"],{"timeout_ms":10000,"max_output_bytes":4096})
check(refused.exitcode == 1 && parse_json(refused.stdout)["error_code"] == "restore_conflict", "CLI restore conflict remains operational failure")
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
