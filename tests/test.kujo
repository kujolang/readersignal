from src.core import dispatch
from src.args import parse_args
mut pass:=0;mut fail:=0
func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
root:=env_or("READERSIGNAL_TEST_TMP","/tmp")+"/readersignal-test-"+uuid_v4()
func opts(v){return parse_args(v,["json","dry-run","force","act","yes"])}
check(dispatch("init",opts(["--state",root]))["ok"],"init")
created:=dispatch("snapshot",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))
check(created["ok"],"core workflow");id:="";if created["ok"]{id=created["value"]["record"]["id"]}
check(!dispatch("snapshot",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))["ok"],"duplicate")
check(!dispatch("snapshot",opts(["--state",root,"--input","fixtures/core.json"]))["ok"],"actor required")
check(!dispatch("show",opts(["--state",root,"--id","../escape"]))["ok"],"traversal")
bad:=root+"/bad.json";write_file(bad,"{",true);check(!dispatch("snapshot",opts(["--state",root,"--input",bad,"--actor","fixture-human"]))["ok"],"malformed JSON")
future:=root+"/future.json";write_file(future,"{\"schema_version\":\"2.0.0\"}",true);check(!dispatch("snapshot",opts(["--state",root,"--input",future,"--actor","fixture-human"]))["ok"],"schema major")
check(dispatch("snapshot",opts(["--state",root,"--input","fixtures/core.json","--actor","fixture-human","--dry-run"]))["value"]["dry_run"],"dry run")
check(dispatch("doctor",opts(["--state",root]))["value"]["healthy"],"doctor")
check(dispatch("version",opts([]))["value"]["version"]=="0.3.0","version")
check(trim(read_file("VERSION")) == "0.3.0", "release marker")
check(contains(read_file("kujo.toml"), "version = \"0.3.0\""), "package release version")
check(contains(read_file("README.md"), "version-0.3.0-black"), "README release version")
check(created["value"]["record"]["tool_version"] == "0.3.0", "new record release version")
check(contains(parse_json(read_file("schemas/record.schema.json"))["properties"]["tool_version"]["enum"], "0.3.0"), "record schema release version")
check(dispatch("export",opts(["--state",root]))["value"]["schema_version"]=="1.0.0","export")
if id!=""{check(dispatch("show",opts(["--state",root,"--id",id]))["ok"],"show")}
if id!=""{for version in ["0.1.0","0.2.0"] {record_path:=root+"/records/"+id+".json";legacy:=parse_json(read_file(record_path));legacy["tool_version"]=version;write_file(record_path,to_json_pretty(legacy)+"\n",true);event_path:=root+"/history/"+substring(sha256(legacy["created_at"]+"\n"+id),0,32)+".json";event:=parse_json(read_file(event_path));event["record_sha256"]=sha256_file(record_path);write_file(event_path,to_json(event),true);check(dispatch("validate",opts(["--state",root,"--id",id]))["ok"],version+" record compatibility")}}
bad_compare:=root+"/bad-compare.json";write_file(bad_compare,"{\"schema_version\":\"1.0.0\",\"window_a\":\"7d\",\"window_b\":\"30d\"}",true)
check(!dispatch("compare",opts(["--state",root,"--input",bad_compare,"--actor","analyst"]))["ok"],"incompatible windows rejected")
learning:=root+"/learning.json";write_file(learning,"{\"schema_version\":\"1.0.0\",\"evidence_ids\":[\"snapshot-fixture\"],\"attribution_limit\":\"correlation only\",\"recommendation\":\"investigate recurring question\"}",true)
check(dispatch("followup",opts(["--state",root,"--input",learning,"--actor","analyst","--timestamp","2026-08-14T00:00:02Z"]))["ok"],"bounded follow-up recommendation")
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
